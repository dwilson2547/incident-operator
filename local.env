# Settings for a local run (start.sh, replay): the local counterpart of the chart's values.yaml. The service has no
# defaults in code, so everything it reads is here. No secrets: export GPU_SCHEDULER_TOKEN yourself if you have one.
# Paths are relative to the repo root; start.sh and replay run from there.

LOG_LEVEL=INFO
DATABASE_URL=postgresql://postgres@127.0.0.1:55444/postgres      # start.sh's io-pg container (PGPASSWORD=dev)
UI_PORT=8090
WEBHOOK_PORT=8091
PUBLIC_URL=http://127.0.0.1:8090

PRIMER_PATH=helm/incident-operator/files/primer.md
RUNBOOKS_DIR=helm/incident-operator/files/runbooks
OPERATIONS_DIR=helm/incident-operator/files/operations

# Triage needs a reachable gpu-scheduler; without one, incidents stay `new` and are retried every few seconds.
GPU_SCHEDULER_URL=http://127.0.0.1:8000
TRIAGE_MODEL=qwen35-9b
TRIAGE_FALLBACK=
TRIAGE_FALLBACK_AFTER_SECONDS=60
TRIAGE_FALLBACK_MAX_PROMPT_TOKENS=12000
TRIAGE_DEADLINE_SECONDS=900
TRIAGE_MAX_NEW_TOKENS=1024
TRIAGE_INVESTIGATE_MAX_NEW_TOKENS=1536
TRIAGE_REPEAT_WINDOW_SECONDS=21600
TRIAGE_MAX_PER_HOUR=12
TRIAGE_SKIP_RESOLVED_AFTER_SECONDS=3600
TRIAGE_RERUN_MODELS='[{"name": "qwen35-9b", "label": "Qwen3.5 9B", "max_prompt_tokens": 48000}]'

PROMETHEUS_URL=http://127.0.0.1:9090
PROBE_NAMESPACE=
PROBE_IMAGE=

SMTP_HOST=                  # empty: email off
OIDC_ISSUER=                # empty: no sign-in

# Local-run switches (optional; the chart never sets them).
EVIDENCE=off                # no Kubernetes reads; or unset it and set KUBE_API_URL to a `kubectl proxy`
ALLOW_ANONYMOUS_DECISIONS=1 # approve without sign-in; no executor runs locally, so an approved fix waits, then times out
